-- AUTO PATTERN: finds the game's other map patterns and swaps them too

if AUTO_PATTERN then
task.spawn(function()
local cam = workspace.CurrentCamera

local function detect()
local counts, n = {}, 0
for _, d in ipairs(workspace:GetDescendants()) do
n = n + 1
if n % 300 == 0 then task.wait() end
if d.ClassName == "Texture" then
local v = d.Texture
if v ~= "" and not v:find("^rbxasset://") then
local id = v:match("rbxassetid://(%d+)") or v:match("[?&]id=(%d+)")
local part = d.Parent
if id and resolved[id] == nil and part and part:IsA("BasePart")
and part.Size.Magnitude > 6 and not excluded(d)
and not (cam and d:IsDescendantOf(cam)) then
counts[id] = (counts[id] or 0) + 1
end
end
end
end
for id, c in pairs(counts) do
if c >= AUTO_MIN_COUNT then
resolved[id] = TILE
log("auto pattern id " .. id .. " (x" .. c .. ")")
end
end
n = 0
for _, d in ipairs(workspace:GetDescendants()) do
n = n + 1
if n % 300 == 0 then task.wait() end
if d.ClassName == "Texture" then trySwap(d, "Texture") end
end
end

for _, t in ipairs({3, 7, 15, 25}) do    
    task.wait(t)    
    pcall(detect)    
end

end)

end


---

-- FALLBACK: blocks on flat parts that are still bare

if FALLBACK_PARTS then
task.spawn(function()
task.wait(3)
local cam = workspace.CurrentCamera
local seen = setmetatable({}, {__mode = "k"})

local function skin(part)
if fallbackParts >= MAX_PARTS or seen[part] then return end
if not part:IsA("BasePart") or not plainEnough(part) then return end
if part.Transparency >= 0.95 then return end
local s = part.Size
if math.max(s.X, s.Y, s.Z) < MIN_SIZE then return end
if cam and part:IsDescendantOf(cam) then return end
if excluded(part) then return end
for _, p in ipairs(Players:GetPlayers()) do
if p.Character and part:IsDescendantOf(p.Character) then return end
end
seen[part] = true

local covered, foreign = {}, {}    
    for _, c in ipairs(part:GetChildren()) do    
        if c:IsA("Decal") and c.Texture == TILE and c.Transparency < 1 then    
            covered[c.Face] = true    
        elseif HIDE_OTHER_TEXTURES and c.ClassName == "Texture"    
            and c.Name ~= "_McBlock" and c.Texture ~= "" and c.Transparency < 1 then    
            foreign[#foreign + 1] = c    
        end    
    end    

    local added = false    
    for _, face in ipairs(Enum.NormalId:GetEnumItems()) do    
        if not covered[face] then    
            local a, b = faceSize(part, face)    
            local skip = math.min(a, b) < MIN_FACE    
                or (face == Enum.NormalId.Bottom and part.Position.Y < 5)    
            if not skip then    
                for _, f in ipairs(foreign) do    
                    if f.Face == face then f.Transparency = 1 end    
                end    
                local u, v = fitScale(part, face)    
                local t = Instance.new("Texture")    
                t.Name = "_McBlock"    
                t.Texture = TILE    
                t.Face = face    
                t.StudsPerTileU = u    
                t.StudsPerTileV = v    
                t.Color3 = TINT    
                t.Parent = part    
                added = true    
            end    
        end    
    end    
    if added then fallbackParts = fallbackParts + 1 end    
end    

local function scan()    
    local n = 0    
    for _, obj in ipairs(workspace:GetDescendants()) do    
        skin(obj)    
        n = n + 1    
        if n % 100 == 0 then task.wait() end    
    end    
end    

scan()    
workspace.DescendantAdded:Connect(function(o)    
    task.delay(3, skin, o)    
end)    
for _, t in ipairs({8, 20, 40}) do    
    task.wait(t)    
    scan()    
end

end)

end

task.wait(3)
report()
task.delay(30, report)
log("done")
