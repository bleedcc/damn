-- SETTINGS

local PACK_URL = "https://raw.githubusercontent.com/itzsum1tblox/Rivals-minecraft-texture-itzsum1tblox-/main/Minecraft_Classic_Pack_v1.2%28day%29.json"
local PATTERN_ID = "136887158756561" -- the game's map pattern
local TILE_STUDS = 4                 -- size of one block in studs (lower = smaller blocks)
local AUTO_PATTERN = false           -- finds the game's other map patterns (fixes half map)
local AUTO_MIN_COUNT = 25
local FALLBACK_PARTS = false         -- covers surfaces that are still bare
local HIDE_OTHER_TEXTURES = false
local MIN_SIZE = 4
local MIN_FACE = 2
local MAX_PARTS = 20000
local TINT = Color3.fromRGB(175, 175, 175) -- brightness of blocks (lower = darker, fixes washed-out walls)

-- LOADING SCREEN / LOGO
local LOGO_MODE = "custom"           -- "custom" = your logo.png, "original" = game's logo, "remove" = hide it
local LOGO_URL = "https://raw.githubusercontent.com/itzsum1tblox/Rivals-minecraft-texture-itzsum1tblox-/main/logo.png"
local TEXT_SWAP = true               -- changes any text saying "66mods" into NAME_TEXT
local NAME_TEXT = "itzsum1tblox"

-- Folders directly under Workspace that should NOT get blocks (the lobby)
local EXCLUDE_NAMES = {"Lobby", "LobbyMap", "Hub", "Spawn"}

local function log(m) print("[MC] " .. tostring(m)) end

local EXCLUDE = {}
for _, n in ipairs(EXCLUDE_NAMES) do EXCLUDE[n:lower()] = true end

local function topOf(inst)
local top = inst
while top.Parent and top.Parent ~= workspace do top = top.Parent end
return top
end

local function excluded(inst)
if not inst:IsDescendantOf(workspace) then return false end
return EXCLUDE[topOf(inst).Name:lower()] == true
end

-- face sizes + square tiles that line up with a part's edges (used for bare surfaces)
local function faceSize(part, face)
local s = part.Size
if face == Enum.NormalId.Top then
if part:IsA("WedgePart") then
return s.X, math.sqrt(s.Y * s.Y + s.Z * s.Z)
end
return s.X, s.Z
elseif face == Enum.NormalId.Bottom then
return s.X, s.Z
elseif face == Enum.NormalId.Front or face == Enum.NormalId.Back then
return s.X, s.Y
end
return s.Z, s.Y
end

local function plainEnough(part)
if part.ClassName == "WedgePart" then return true end
return part.ClassName == "Part" and part.Shape == Enum.PartType.Block
end

local function fitScale(part, face)
local a, b = faceSize(part, face)
local s = math.max(1, math.min(TILE_STUDS, a, b))
local nu = math.max(1, math.floor(a / s + 0.5))
local nv = math.max(1, math.floor(b / s + 0.5))
return a / nu, b / nv
end


