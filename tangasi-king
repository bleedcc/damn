-- BLOCK TILE (built in, no download needed)

local B64 = ""

local function decode(s)
local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local map = {}
for i = 1, 64 do map[chars:sub(i, i)] = i - 1 end
local out, acc, bits = {}, 0, 0
for c in s:gmatch("[A-Za-z0-9+/]") do
acc = acc * 64 + map[c]
bits = bits + 6
if bits >= 8 then
bits = bits - 8
local d = 2 ^ bits
local byte = math.floor(acc / d)
acc = acc - byte * d
out[#out + 1] = string.char(byte)
end
end
return table.concat(out)
end

local TILE
do
local ok, err = pcall(function()
writefile("mc_tile_v2.png", decode(B64))
TILE = getcustomasset("mc_tile_v2.png")
end)
if not ok or not TILE then
warn("[MC] Tile failed: " .. tostring(err))
return
end
end


---

-- PACK (sounds, icons, skies) + MAP PATTERN -> BLOCKS

local Players = game:GetService("Players")
local stats, swaps, done = {}, 0, {}
local fallbackParts = 0
local resolved = {}

local function dedupe(parent, face)
if not parent then return end
for _, c in ipairs(parent:GetChildren()) do
if c.Name == "_McBlock" and c:IsA("Decal") and c.Face == face then
c:Destroy()
end
end
end

local function applyTile(inst, p)
stats[inst.ClassName] = (stats[inst.ClassName] or 0) + 1
if inst:IsA("Texture") then
inst.Texture = TILE
inst.StudsPerTileU = TILE_STUDS
inst.StudsPerTileV = TILE_STUDS
inst.Transparency = 0
inst.Color3 = TINT
dedupe(inst.Parent, inst.Face)
elseif inst:IsA("Decal") then
if done[inst] then return end
done[inst] = true
local t = Instance.new("Texture")
t.Name = "_McTile"
t.Face = inst.Face
t.Texture = TILE
t.StudsPerTileU = TILE_STUDS
t.StudsPerTileV = TILE_STUDS
t.Color3 = TINT
t.Parent = inst.Parent
inst.Transparency = 1
dedupe(inst.Parent, inst.Face)
else
inst[p] = TILE
end
end

local function report()
local list = {}
for k, v in pairs(stats) do list[#list + 1] = k .. "=" .. v end
log("swaps=" .. swaps .. " | map pattern replaced: " .. (#list > 0 and table.concat(list, ", ") or "none yet") .. " | extra parts: " .. fallbackParts)
end

local PROPS = {
Sound = {"SoundId"},
ImageLabel = {"Image"},
ImageButton = {"Image", "HoverImage", "PressedImage"},
Decal = {"Texture"},
Texture = {"Texture"},
ParticleEmitter = {"Texture"},
Beam = {"Texture"},
Trail = {"Texture"},
MeshPart = {"TextureID"},
SpecialMesh = {"TextureId"},
Sky = {"SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp"},
}

local function trySwap(inst, p)
local ok3, v = pcall(function() return inst[p] end)
if not ok3 or type(v) ~= "string" or v:find("^rbxasset://") then return end
local id = v:match("rbxassetid://(%d+)") or v:match("[?&]id=(%d+)")
local new = id and resolved[id]
if new == nil then return end
if new == TILE and excluded(inst) then return end
swaps = swaps + 1
if new == TILE then
pcall(applyTile, inst, p)
else
pcall(function() inst[p] = new end)
end
end

-- changes "66mods" text (any capitalization) into NAME_TEXT
local function fixText(inst)
if not (inst:IsA("TextLabel") or inst:IsA("TextButton")) then return end
local function fix()
local ok4, t = pcall(function() return inst.Text end)
if ok4 and type(t) == "string" and t ~= "" then
local new, n = string.gsub(t, "66%s*[Mm][Oo][Dd][Ss]", NAME_TEXT)
if n > 0 then pcall(function() inst.Text = new end) end
end
end
fix()
inst:GetPropertyChangedSignal("Text"):Connect(fix)
end

local function handle(inst)
if TEXT_SWAP then fixText(inst) end
local props = PROPS[inst.ClassName]
if not props then return end
for _, p in ipairs(props) do
trySwap(inst, p)
inst:GetPropertyChangedSignal(p):Connect(function() trySwap(inst, p) end)
end
end

local ok, err = pcall(function()
local rules = game:GetService("HttpService"):JSONDecode(game:HttpGet(PACK_URL)).replacement_rules
local cache = {}

local function getAsset(url)
if cache[url] then return cache[url] end
local name = "mcpack_" .. url:match("([^/]+)$")
if not isfile(name) then writefile(name, game:HttpGet(url)) end
cache[url] = getcustomasset(name)
return cache[url]
end

local good, bad = 0, 0
for _, r in ipairs(rules) do
if r.enabled then
local value
if r.mode == "id" then
value = ""
elseif r.cdn_url and not r.cdn_url:match("%.obj$") then
local ok2, res = pcall(getAsset, r.cdn_url)
if ok2 and res then
value = res
good = good + 1
else
bad = bad + 1
warn("[MC] Failed: " .. tostring(r.name))
end
end
if value ~= nil then
for _, id in ipairs(r.replace_ids) do
resolved[string.format("%.0f", id)] = value -- full digits, no e+14
end
end
end
end
resolved[PATTERN_ID] = TILE -- map pattern becomes blocks
log("files ok=" .. good .. " failed=" .. bad)

-- LOADING SCREEN / LOGO (the 66mods logo images from the pack)
local LOGO_IDS = {"17803962335", "13854780213", "13854780042"}
if LOGO_MODE == "original" then
for _, id in ipairs(LOGO_IDS) do resolved[id] = nil end
elseif LOGO_MODE == "remove" then
for _, id in ipairs(LOGO_IDS) do resolved[id] = "" end
elseif LOGO_MODE == "custom" then
local okL, asset = pcall(getAsset, LOGO_URL)
if okL and asset then
resolved["17803962335"] = asset
resolved["13854780213"] = asset
resolved["13854780042"] = ""
log("custom logo loaded")
else
warn("[MC] logo download failed - upload logo.png to your repo")
end
end

for _, inst in ipairs(game:GetDescendants()) do
task.spawn(handle, inst)
end
game.DescendantAdded:Connect(function(inst)
task.defer(handle, inst)
end)

end)
if not ok then warn("[MC] Pack error: " .. tostring(err)) end


